# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# OpenAI (required for server-side Smart Import screenshot/image parsing)
OPENAI_API_KEY=

# Resend - participant email notifications (optional; if unset, emails are skipped)
RESEND_API_KEY=re_xxxx
# Optional: override default sender (default: onboarding@resend.dev for testing)
# EMAIL_FROM=Playerhoods <notifications@example.com>

# Optional: site URL for email links (default: VERCEL_URL or http://127.0.0.1:3000)
# NEXT_PUBLIC_SITE_URL=https://www.playerhoods.com
